# HTTP server
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# MongoDB (stores every message that goes through the gateway)
MONGODB_URI=mongodb://localhost:27017/whatsapp-flow

# RabbitMQ (inbound messages are published here for the flow-engine)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Key clients must send as "Authorization: Bearer <API_KEY>"
API_KEY=change-me

# App secret of your Meta app, used to verify the webhook signature
META_APP_SECRET=your-meta-app-secret

# Graph API base URL including a version Meta currently supports (optional)
WHATSAPP_API_URL=https://graph.facebook.com/v23.0

# Where environment variables come from: "dotenv" (default) or "gcp-secret-manager".
# With gcp-secret-manager, GOOGLE_CLOUD_PROJECT must be set in the real environment.
# ENV_SOURCE=dotenv
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
