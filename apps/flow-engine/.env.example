# MongoDB (flows and conversation state)
MONGODB_URI=mongodb://localhost:27017/whatsapp-flow

# RabbitMQ (inbound messages published by the gateway)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# socket.io server for external listeners (the SDK connects here)
SOCKET_PORT=3001
SOCKET_AUTH_TOKEN=change-me
CORS_ORIGIN=*

# Gateway: used to read message history and to send answers
GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY=change-me

# WhatsApp Business number the flows answer from
# Phone number, digits only with country code
WHATSAPP_SENDER_NUMBER=15550001111
# Phone number ID of that number in the WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Meta access token allowed to send messages from that number
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# Base URL where media referenced by flows is hosted (optional).
# A media id in a flow resolves to <MEDIA_BASE_URL>/<flow id>/<media id>
# MEDIA_BASE_URL=https://media.example.com/flows

# Language code of the message templates referenced by flows (optional)
TEMPLATE_LANGUAGE=en_US

# Where environment variables come from: "dotenv" (default) or "gcp-secret-manager".
# With gcp-secret-manager, GOOGLE_CLOUD_PROJECT must be set in the real environment.
# ENV_SOURCE=dotenv
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
